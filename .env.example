# ============================================================
#  Summit Air agent config template.
#  Copy to .env and fill in:  cp .env.example .env
# ============================================================

# Your Vapi PRIVATE API key (Vapi Dashboard -> API Keys). REQUIRED.
VAPI_API_KEY=

# The assistant to provision (create_assistant.py updates this id in place).
VAPI_ASSISTANT_ID=

# The Twilio phone number's id (attach_number.py assign <this>).
PHONE_NUMBER_ID=

# Local backend port.
PORT=8001

# Auto-filled by start.sh after ngrok comes up.
WEBHOOK_URL=
