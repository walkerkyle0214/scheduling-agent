# ============================================================
#  Summit Air agent config template.
#  Copy to .env and fill in:  cp .env.example .env
# ============================================================

# Your Vapi PRIVATE API key (Vapi Dashboard -> API Keys). REQUIRED.
VAPI_API_KEY=

# The assistant to provision (create_assistant.py updates this id in place).
VAPI_ASSISTANT_ID=

# The Twilio phone number's id (attach_number.py assign <this>).
PHONE_NUMBER_ID=

# Local backend port.
PORT=8001

# LLM the assistant uses (via Vapi). openai pass-through needs no extra key.
LLM_PROVIDER=openai
MODEL=gpt-4o-mini

# Optional — LLM-as-judge for behavioral eval checks (tests/evals.py). Direct
# Anthropic API key (console.anthropic.com). Blank => judged scenarios fall back
# to keyword checks. JUDGE_MODEL=claude-haiku-4-5 is a cheaper grader.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-opus-4-8

# Auto-filled by start.sh after ngrok comes up.
WEBHOOK_URL=
